# Copiar como .env para cambiar algún valor de Docker Compose. Sin .env se usan estos mismos valores.
# Son solo para desarrollo y demo: en producción usa valores propios y nunca los subas al repositorio.

# Puerto de la aplicación en el equipo (http://localhost:5173)
DOCENTIA_WEB_PUERTO=5173
# Puerto de la API en el equipo (http://localhost:8090/api)
DOCENTIA_API_PUERTO=8090

# Base de datos
DOCENTIA_DB_USUARIO=docentia
DOCENTIA_DB_CONTRASENA=docentia

# Perfil de Spring. "dev" carga los datos de demo y el análisis con el modelo simulado.
SPRING_PROFILES_ACTIVE=dev
